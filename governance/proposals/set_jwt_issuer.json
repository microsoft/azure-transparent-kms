{
    "actions": [
      {
        "name": "set_jwt_issuer",
        "args": {
          "issuer":  "${JWT_ISSUER}",
          "key_filter": "all",
          "jwks": {
            "keys": [
              ${JWK}
            ]
          }
        }
      },
      {
        "name": "set_jwt_public_signing_keys",
        "args": {
          "issuer": "${JWT_ISSUER}",
          "jwks": {
            "keys": [
              ${JWK}
            ]
          }
        }
      }
    ]
}